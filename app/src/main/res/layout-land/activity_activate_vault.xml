<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.supremainc.sfm_sdk_android.ActivateVaultActivity">

    <!-- Background image with centerCrop -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_img2"
        android:scaleType="centerCrop"
        android:contentDescription="Background" />

    <!-- Background overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cardview_shadow_start_color"
        android:alpha="0.4" />

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_button"
            android:contentDescription="@string/back_button"
            android:tint="@color/white"
            android:padding="12dp" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/activate_vault"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginHorizontal="16dp" />

        <LinearLayout
            android:id="@+id/language_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/container_background"
            android:backgroundTint="@color/buttonBackground"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_language"
                android:textSize="18sp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Language" />

            <Spinner
                android:id="@+id/language_spinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="120dp"
                android:popupBackground="@color/white"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:padding="16dp">

        <!-- Main container with responsive layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Status Section - Compact for landscape -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/container_background"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_activation_status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready to scan fingerprint - Need 3 authorized users"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:background="@color/cardview_light_background"
                    android:padding="10dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Two-column layout for landscape optimization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Left Column: Vault Progress + Fingerprint -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <!-- Vault Progress Section - More compact -->
                    <LinearLayout
                        android:id="@+id/vault_progress_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/container_background"
                        android:padding="16dp"
                        android:elevation="2dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vault Access Progress"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal" />

                        <!-- Compact Progress Indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="12dp">

                            <!-- Progress Dot 1 -->
                            <View
                                android:id="@+id/progress_dot_1"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/progress_dot_empty"
                                android:layout_marginEnd="8dp" />

                            <!-- Connector Line 1 -->
                            <View
                                android:layout_width="30dp"
                                android:layout_height="2dp"
                                android:background="@color/textSecondary"
                                android:layout_marginEnd="8dp"
                                android:layout_gravity="center_vertical" />

                            <!-- Progress Dot 2 -->
                            <View
                                android:id="@+id/progress_dot_2"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/progress_dot_empty"
                                android:layout_marginEnd="8dp" />

                            <!-- Connector Line 2 -->
                            <View
                                android:layout_width="30dp"
                                android:layout_height="2dp"
                                android:background="@color/textSecondary"
                                android:layout_marginEnd="8dp"
                                android:layout_gravity="center_vertical" />

                            <!-- Progress Dot 3 -->
                            <View
                                android:id="@+id/progress_dot_3"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/progress_dot_empty" />

                        </LinearLayout>

                        <!-- Progress Text -->
                        <TextView
                            android:id="@+id/progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 of 3 users verified"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="8dp" />

                        <!-- Waiting Message -->
                        <TextView
                            android:id="@+id/waiting_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳ Waiting for first user..."
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:layout_gravity="center_horizontal"
                            android:textStyle="italic"
                            android:layout_marginBottom="8dp" />

                    </LinearLayout>

                    <!-- Fingerprint Scanning Section - Compact -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/container_background"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:elevation="2dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vault_fingerprint_scan"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/instruction_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Place finger on scanner for vault access"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:textAlignment="center" />

                        <ImageView
                            android:id="@+id/fingerprint_image"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/fingerprint_icon"
                            android:contentDescription="Fingerprint scanner"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/fingerprint_background"
                            android:padding="16dp" />

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/scan_button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/scan_fingerprint"
                            android:textColor="@color/buttonText"
                            android:backgroundTint="@color/buttonBackground"
                            android:background="@drawable/container_background"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:elevation="1dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Right Column: Verified Users List -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <!-- Verified Users Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/container_background"
                        android:padding="16dp"
                        android:elevation="2dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified Users"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="12dp" />

                        <!-- Verified Users List - Scrollable for many users -->
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="200dp"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:id="@+id/verified_users_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <!-- Dynamic user cards will be added here programmatically -->

                            </LinearLayout>

                        </ScrollView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons Section - Full width at bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/retry_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Reset Session"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:background="@drawable/container_background"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/confirm_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="OPEN VAULT"
                    android:textSize="14sp"
                    android:textColor="@color/buttonText"
                    android:backgroundTint="@color/buttonBackground"
                    android:background="@drawable/container_background"
                    android:textStyle="bold"
                    android:elevation="2dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>