<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_img2">

    <!-- 1. Semi-transparent overlay background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:alpha="0.4" />

    <!-- 2. Foreground content (normal UI) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Help Button top-left -->
        <Button
            android:id="@+id/btn_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/buttonBackground"
            android:padding="10dp"
            android:text="Help"
            android:textColor="@color/buttonText"
            android:background="@drawable/button_border"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/language_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/button_border"
            android:backgroundTint="@color/buttonBackground"
            android:padding="8dp"
            app:layout_constraintBaseline_toBaselineOf="@id/btn_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_language"
                android:layout_marginEnd="8dp"
                android:contentDescription="Language" />

            <Spinner
                android:id="@+id/language_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="80dp"
                android:backgroundTint="@color/buttonText"
                android:popupBackground="@color/buttonBackground" />

        </LinearLayout>


        <!-- Title in center top -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_menu_title"
            android:textSize="28sp"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_info"
            app:layout_constraintEnd_toStartOf="@id/language_container"
            app:layout_constraintBottom_toBottomOf="@id/btn_info"
            android:gravity="center" />

        <!-- Left Section -->
        <LinearLayout
            android:id="@+id/leftContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/btn_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightContainer"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/baseline_person_24"
                android:contentDescription="App Logo" />

            <TextView
                android:id="@+id/tvSecurityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/GEMS_fullname"
                android:textColor="@color/textPrimary"
                android:textSize="20sp"
                android:textStyle="italic"
                android:layout_marginTop="16dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Right Section -->
        <LinearLayout
            android:id="@+id/rightContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btn_info"
            app:layout_constraintStart_toEndOf="@id/leftContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp">

            <Button
                android:id="@+id/btn_fingerprint_enrollment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fingerprint_enrollment"
                android:textColor="@color/buttonText"
                android:backgroundTint="@color/buttonBackground"
                android:background="@drawable/button_border"
                android:textSize="20sp"
                android:layout_marginBottom="20dp"
                android:padding="20dp" />

            <Button
                android:id="@+id/btn_activate_vault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activate_vault"
                android:textColor="@color/buttonText"
                android:backgroundTint="@color/buttonBackground"
                android:background="@drawable/button_border"
                android:textSize="20sp"
                android:layout_marginBottom="20dp"
                android:padding="20dp" />

            <Button
                android:id="@+id/btn_system_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_settings"
                android:textColor="@color/buttonText"
                android:backgroundTint="@color/buttonBackground"
                android:textSize="20sp"
                android:background="@drawable/button_border"
                android:layout_marginBottom="20dp"
                android:padding="20dp" />

            <Button
                android:id="@+id/btn_log_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logout"
                android:textColor="@color/buttonText"
                android:backgroundTint="@color/buttonBackground"
                android:background="@drawable/button_border"
                android:textSize="20sp"
                android:padding="20dp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>