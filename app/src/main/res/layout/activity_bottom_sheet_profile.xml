<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/container_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/container_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Name -->
            <TextView
                android:id="@+id/profileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/profileRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role: Loading..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/buttonBackground"
                android:padding="8dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/textSecondary"
                android:alpha="0.3"
                android:layout_marginBottom="16dp" />

            <!-- Staff ID -->
            <TextView
                android:id="@+id/profileStaffId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff ID: Loading..."
                android:textSize="16sp"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="12dp" />

            <!-- IC Number -->
            <TextView
                android:id="@+id/profileIcNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IC Number: Loading..."
                android:textSize="16sp"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="12dp" />

            <!-- Department -->
            <TextView
                android:id="@+id/profileDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Department: Loading..."
                android:textSize="16sp"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnCloseProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/buttonText"
            android:backgroundTint="@color/buttonBackground"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>