<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.supremainc.sfm_sdk_android.LoginActivity">

    <!-- Background image with centerCrop -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_img2"
        android:scaleType="centerCrop"
        android:contentDescription="Background" />

    <!-- Background overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cardview_shadow_start_color"
        android:alpha="0.4" />

    <!-- Language selector in top-right -->
    <LinearLayout
        android:id="@+id/language_container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/container_background"
        android:backgroundTint="@color/buttonBackground"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="ðŸŒ"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:contentDescription="Language" />

        <Spinner
            android:id="@+id/language_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:popupBackground="@color/white" />

    </LinearLayout>

    <!-- Main login content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Spacer to center content -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Login Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/container_background"
                android:padding="32dp"
                android:elevation="4dp"
                android:layout_marginHorizontal="20dp">

                <!-- App Logo -->
                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/bnm_logo_official"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="App Logo" />

                <!-- Login Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/GEMS_fullname"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Login Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_subtitle"
                    android:textSize="16sp"
                    android:textColor="@color/textSecondary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:gravity="center" />

                <!-- Staff ID Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/staff_id_hint"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/staffIdEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:visibility="gone"
                        android:maxLength="20" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/password_hint"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLength="50" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Login Button -->
                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/login"
                    android:textColor="@color/buttonText"
                    android:backgroundTint="@color/buttonBackground"
                    android:background="@drawable/container_background"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone" />

                <!-- Default Credentials Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_credentials_info"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:background="@color/cardview_light_background"
                    android:padding="12dp" />

                <!-- Divider with OR text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/textSecondary"
                        android:alpha="0.3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/or"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:textColor="@color/textSecondary"
                        android:paddingHorizontal="16dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/textSecondary"
                        android:alpha="0.3" />

                </LinearLayout>

                <!-- Fingerprint Login Button -->
                <Button
                    android:id="@+id/fingerprintLoginButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/login_with_fingerprint"
                    android:textColor="@color/buttonBackground"
                    android:backgroundTint="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/fingerprint_icon2"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="16dp"
                    style="?attr/materialButtonOutlinedStyle"
                    app:strokeColor="@color/buttonBackground"
                    app:strokeWidth="2dp" />

            </LinearLayout>

            <!-- Spacer to center content -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>