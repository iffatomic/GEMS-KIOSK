<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_img2"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Toolbar with back button and title -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/back_button" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:text="Manual Key Override Activation"
                android:textColor="@color/buttonText"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>

        <!-- Main Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Step Indicator -->
            <LinearLayout
                android:id="@+id/stepIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/container_background"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/stepNumber"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/container_background"
                    android:backgroundTint="@color/colorAccent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/buttonText"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Supervisor Identification"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STEP 1: Supervisor ID Input -->
            <LinearLayout
                android:id="@+id/step1Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/container_background"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step 1: Enter Supervisor ID"
                    android:textAlignment="center"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supervisor ID"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/supervisorIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Enter Supervisor ID"
                    android:backgroundTint="@color/white"
                    android:inputType="text"
                    android:textColor="@color/black"
                    android:textColorHint="@color/textSecondary"
                    android:padding="12dp"
                    android:background="@drawable/container_background" />

                <Button
                    android:id="@+id/btnNextToFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next: Scan Fingerprint"
                    android:textColor="@color/buttonText"
                    android:backgroundTint="@color/buttonBackground"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STEP 2: Fingerprint Scan -->
            <LinearLayout
                android:id="@+id/step2Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/container_background"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step 2: Supervisor Fingerprint Verification"
                    android:textAlignment="center"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Fingerprint Animation Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="#40FFFFFF"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/fingerprintIcon"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/fingerprint_icon"
                        android:contentDescription="Fingerprint"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/fingerprintStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Place finger on scanner"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/fingerprintProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBackToStep1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Back"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/colorSurface"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnScanFingerprint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scan Fingerprint"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/buttonBackground"
                        android:padding="16dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 3: Vault Selection -->
            <LinearLayout
                android:id="@+id/step3Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/container_background"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step 3: Select Vault/Compartment"
                    android:textAlignment="center"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Vault/Compartment"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/vaultSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/container_background"
                    android:padding="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBackToStep2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Back"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/colorSurface"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnNextToTimeFrame"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next: Set Time Frame"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/buttonBackground"
                        android:padding="16dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 4: Time Frame Setting -->
            <LinearLayout
                android:id="@+id/step4Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/container_background"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step 4: Set Override End Time"
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select when the manual override should automatically expire"
                    android:textAlignment="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

                <!-- Start Time Info (Read-only, shows current time) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#40808080"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Override Start Time"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 Now (Immediate activation)"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- End Time Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#40FFA500"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Override End Time"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Selected End Time Display -->
                    <TextView
                        android:id="@+id/selectedEndTimeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="End Time: Not selected\n(Tap button below to set)"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"
                        android:minHeight="48dp"
                        android:gravity="center_vertical" />

                    <!-- Pick Date/Time Button -->
                    <Button
                        android:id="@+id/btnPickEndDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 Select End Date &amp; Time"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="16dp"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Info Note -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Maximum override period: 7 days from now"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="12sp"
                    android:padding="12dp"
                    android:background="#40FFA500"
                    android:layout_marginBottom="16dp" />

                <!-- Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBackToStep3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Back"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/colorSurface"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnNextToConfirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Start Override"
                        android:textColor="@color/buttonText"
                        android:backgroundTint="@color/buttonBackground"
                        android:padding="16dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 5: Override Process & Manual Key Holders -->
            <LinearLayout
                android:id="@+id/step5Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/container_background"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step 5: Manual Key Override Process"
                    android:textAlignment="center"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 Manual Key Holders must turn their key switches simultaneously"
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <!-- Key Holder Status Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <!-- Key Holder 1 -->
                    <LinearLayout
                        android:id="@+id/keyHolder1Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#40FFFFFF"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/container_background"
                            android:backgroundTint="@color/colorAccent"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/buttonText"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Key Holder 1"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/keyHolder1Icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/fingerprint_icon"
                            android:contentDescription="Status"
                            android:alpha="0.3" />

                        <TextView
                            android:id="@+id/keyHolder1Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Waiting..."
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Key Holder 2 -->
                    <LinearLayout
                        android:id="@+id/keyHolder2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#40FFFFFF"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/container_background"
                            android:backgroundTint="@color/colorAccent"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/buttonText"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Key Holder 2"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/keyHolder2Icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/fingerprint_icon"
                            android:contentDescription="Status"
                            android:alpha="0.3" />

                        <TextView
                            android:id="@+id/keyHolder2Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Waiting..."
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Key Holder 3 -->
                    <LinearLayout
                        android:id="@+id/keyHolder3Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#40FFFFFF"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/container_background"
                            android:backgroundTint="@color/colorAccent"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/buttonText"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Key Holder 3"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/keyHolder3Icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/fingerprint_icon"
                            android:contentDescription="Status"
                            android:alpha="0.3" />

                        <TextView
                            android:id="@+id/keyHolder3Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Waiting..."
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Overall Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#4000FF00"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:id="@+id/overrideSuccessContainer">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ VAULT OPENED"
                        android:textAlignment="center"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manual Key Override Active"
                        android:textAlignment="center"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/timeRemainingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time Remaining: 23:59:45"
                        android:textAlignment="center"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCancelOverride"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel Manual Override Mode"
                    android:textColor="@color/buttonText"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Security Notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#40FF0000">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔒 Security Notice"
                    android:textColor="@android:color/holo_red_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All manual override activations are logged and monitored. Unauthorized use will be reported to security personnel. Email notifications will be sent to respective supervisors."
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</ScrollView>